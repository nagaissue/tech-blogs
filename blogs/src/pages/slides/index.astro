---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import SlidesLayout from '../../layouts/SlidesLayout.astro';
import { SLIDE_CATEGORIES, SLIDE_CATEGORY_KEYS, SLIDES_DESCRIPTION, SLIDES_TITLE } from '../../consts';
import commandThumb from '../../assets/slides/10-pt-router-config/slide_1.png';

// 開催回の昇順（回数なしは末尾）、同じ回はタイトル順
const decks = (await getCollection('slides')).sort(
	(a, b) =>
		(a.data.session ?? Infinity) - (b.data.session ?? Infinity) ||
		a.data.title.localeCompare(b.data.title, 'ja'),
);

type Card = {
	href: string;
	title: string;
	description: string;
	category: keyof typeof SLIDE_CATEGORIES;
	session?: number;
	thumb: typeof commandThumb;
	badge: string;
	search: string;
};

const cards: Card[] = [
	...decks.map((d) => ({
		href: `/slides/${d.id}/`,
		title: d.data.title,
		description: d.data.description,
		category: d.data.category,
		session: d.data.session,
		thumb: d.data.slides[0].image,
		badge: `📄 ${d.data.slides.length} スライド`,
		search: [d.data.title, d.data.description, ...d.data.slides.map((s) => s.title)].join(' '),
	})),
	{
		href: '/slides/reference/cisco-router-commands/',
		title: 'Ciscoルータ 基本コマンド一覧',
		description:
			'ユーザEXECモード、特権EXECモード、グローバルコンフィギュレーションモード等の主要CLIコマンド一覧リファレンス。',
		category: 'reference',
		thumb: commandThumb,
		badge: '📖 リファレンス',
		search: 'Ciscoルータ 基本コマンド一覧 enable configure terminal EXEC コマンド',
	},
];

const totalSlides = decks.reduce((n, d) => n + d.data.slides.length, 0);
const countBy = (cat: string) => cards.filter((c) => c.category === cat).length;
---

<SlidesLayout title={SLIDES_TITLE} description={SLIDES_DESCRIPTION}>
	<header class="portal-header">
		<div class="portal-nav">
			<a href="/" class="back-link">◀ ブログトップ</a>
			<button class="icon-btn" data-theme-toggle title="テーマ切替">🌓</button>
		</div>
		<h1 class="portal-title">🌐 {SLIDES_TITLE}</h1>
		<p class="portal-subtitle">{SLIDES_DESCRIPTION}</p>
		<div class="portal-stats">
			<span class="stat-item">📚 全 {cards.length} 資料</span>
			<span class="stat-item">📄 合計 {totalSlides} スライド</span>
		</div>
	</header>

	<div class="toolbar">
		<label class="search-box">
			<span class="search-icon" aria-hidden="true">🔍</span>
			<input
				type="search"
				id="searchInput"
				class="search-input"
				placeholder="資料タイトル・キーワード・コマンド名で検索... (例: Packet Tracer, ルータ, OSPF)"
				aria-label="資料を検索"
			/>
		</label>
		<div class="filter-tabs" role="tablist">
			<button class="filter-tab active" data-cat="all">すべて ({cards.length})</button>
			{
				SLIDE_CATEGORY_KEYS.filter((k) => countBy(k) > 0).map((k) => (
					<button class="filter-tab" data-cat={k}>
						{SLIDE_CATEGORIES[k].icon} {SLIDE_CATEGORIES[k].short} ({countBy(k)})
					</button>
				))
			}
		</div>
	</div>

	<main class="cards-container" id="cardsGrid">
		{
			cards.map((c) => (
				<article class="doc-card" data-category={c.category} data-search={c.search.toLowerCase()}>
					<a href={c.href} class="card-thumb-link" tabindex="-1" aria-hidden="true">
						<div class="card-thumb-box">
							<Image src={c.thumb} alt="" class="card-thumb" width={640} format="webp" />
							<span class="card-badge">
								{SLIDE_CATEGORIES[c.category].icon} {SLIDE_CATEGORIES[c.category].label}
							</span>
							<span class="slide-count-badge">{c.badge}</span>
						</div>
					</a>
					<div class="card-content">
						{c.session && <span class="card-session">第{c.session}回</span>}
						<h2 class="card-title">
							<a href={c.href}>{c.title}</a>
						</h2>
						<p class="card-desc">{c.description}</p>
						<div class="card-actions">
							<a href={c.href} class="card-btn">
								{c.category === 'reference' ? '📖 リファレンスを見る' : '🖥️ スライドを見る'}
							</a>
						</div>
					</div>
				</article>
			))
		}
		<p class="empty-message" id="emptyMsg" hidden>
			一致する資料が見つかりませんでした。別のキーワードでお試しください。
		</p>
	</main>
</SlidesLayout>

<script>
	const input = document.getElementById('searchInput') as HTMLInputElement;
	const tabs = document.querySelectorAll<HTMLElement>('.filter-tab');
	const cards = document.querySelectorAll<HTMLElement>('.doc-card');
	const emptyMsg = document.getElementById('emptyMsg')!;
	let cat = 'all';

	function filter() {
		const q = input.value.trim().toLowerCase();
		let visible = 0;
		cards.forEach((card) => {
			const show =
				(cat === 'all' || card.dataset.category === cat) && (!q || card.dataset.search!.includes(q));
			card.hidden = !show;
			if (show) visible++;
		});
		emptyMsg.hidden = visible > 0;
	}

	input.addEventListener('input', filter);
	tabs.forEach((tab) =>
		tab.addEventListener('click', () => {
			tabs.forEach((t) => t.classList.toggle('active', t === tab));
			cat = tab.dataset.cat!;
			filter();
		}),
	);
</script>

<style>
	.portal-header {
		background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%);
		border-bottom: 1px solid var(--border-color);
		padding: 24px 20px 30px;
		text-align: center;
	}
	:global([data-theme='light']) .portal-header {
		background: linear-gradient(135deg, #f0fdf4 0%, #e0f2fe 100%);
	}
	.portal-nav {
		max-width: 1200px;
		margin: 0 auto 16px;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}
	.portal-title {
		font-size: 2.2rem;
		font-weight: 800;
		background: linear-gradient(90deg, #38bdf8, #818cf8);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
		margin-bottom: 8px;
	}
	.portal-subtitle {
		font-size: 1.05rem;
		color: var(--text-secondary);
		max-width: 650px;
		margin: 0 auto 20px;
		line-height: 1.6;
	}
	.portal-stats {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 12px 20px;
		font-size: 0.9rem;
		color: var(--text-secondary);
	}
	.stat-item {
		background: rgba(var(--accent-rgb), 0.1);
		padding: 4px 14px;
		border-radius: 20px;
		border: 1px solid rgba(var(--accent-rgb), 0.2);
		font-weight: 600;
	}

	.toolbar {
		max-width: 1200px;
		margin: 30px auto 0;
		padding: 0 20px;
		width: 100%;
		display: flex;
		flex-direction: column;
		gap: 16px;
	}
	.search-box {
		position: relative;
		display: block;
	}
	.search-input {
		width: 100%;
		padding: 14px 20px 14px 48px;
		background: var(--card-bg);
		border: 1px solid var(--border-color);
		border-radius: 12px;
		color: var(--text-primary);
		font-size: 1rem;
		box-shadow: var(--shadow);
		outline: none;
		transition: border-color 0.2s, box-shadow 0.2s;
	}
	.search-input:focus {
		border-color: var(--accent);
		box-shadow: 0 0 0 3px rgba(var(--accent-rgb), 0.25);
	}
	.search-icon {
		position: absolute;
		left: 18px;
		top: 50%;
		transform: translateY(-50%);
		font-size: 1.2rem;
	}
	.filter-tabs {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}
	.filter-tab {
		background: var(--card-bg);
		border: 1px solid var(--border-color);
		color: var(--text-secondary);
		padding: 8px 16px;
		border-radius: 20px;
		font-size: 0.85rem;
		font-weight: 600;
		cursor: pointer;
		transition: all 0.2s;
	}
	.filter-tab:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
	.filter-tab.active {
		background: var(--accent);
		color: #fff;
		border-color: var(--accent);
	}

	.cards-container {
		max-width: 1200px;
		margin: 25px auto 60px;
		padding: 0 20px;
		width: 100%;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr));
		gap: 24px;
	}
	.doc-card {
		background: var(--card-bg);
		border: 1px solid var(--border-color);
		border-radius: 12px;
		overflow: hidden;
		box-shadow: var(--shadow);
		display: flex;
		flex-direction: column;
		transition: transform 0.25s ease, border-color 0.25s ease;
	}
	.doc-card[hidden] {
		display: none;
	}
	.doc-card:hover {
		transform: translateY(-4px);
		border-color: rgba(var(--accent-rgb), 0.6);
	}
	.card-thumb-link {
		display: block;
	}
	.card-thumb-box {
		position: relative;
		aspect-ratio: 16 / 9;
		background: #0b1120;
		overflow: hidden;
	}
	.card-thumb {
		width: 100%;
		height: 100%;
		object-fit: contain;
		transition: transform 0.3s ease;
	}
	.doc-card:hover .card-thumb {
		transform: scale(1.03);
	}
	.card-badge {
		position: absolute;
		top: 10px;
		left: 10px;
		padding: 4px 10px;
		border-radius: 12px;
		font-size: 0.75rem;
		font-weight: 700;
		backdrop-filter: blur(4px);
		background: rgba(15, 23, 42, 0.85);
		color: #38bdf8;
		border: 1px solid rgba(56, 189, 248, 0.3);
	}
	.slide-count-badge {
		position: absolute;
		bottom: 10px;
		right: 10px;
		padding: 3px 8px;
		border-radius: 6px;
		font-size: 0.75rem;
		font-weight: 600;
		background: rgba(0, 0, 0, 0.75);
		color: #fff;
	}
	.card-content {
		padding: 18px 20px 20px;
		flex: 1;
		display: flex;
		flex-direction: column;
	}
	.card-session {
		font-size: 0.78rem;
		font-weight: 700;
		color: var(--accent);
		margin-bottom: 4px;
	}
	.card-title {
		font-size: 1.1rem;
		font-weight: 700;
		margin-bottom: 8px;
		line-height: 1.4;
	}
	.card-title a {
		color: var(--text-primary);
		text-decoration: none;
	}
	.card-title a:hover {
		color: var(--accent);
	}
	.card-desc {
		font-size: 0.88rem;
		color: var(--text-secondary);
		line-height: 1.6;
		margin-bottom: 16px;
		flex: 1;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.card-actions {
		border-top: 1px solid var(--border-color);
		padding-top: 14px;
	}
	.card-btn {
		display: inline-flex;
		padding: 7px 12px;
		border-radius: 6px;
		font-size: 0.82rem;
		font-weight: 600;
		text-decoration: none;
		background: var(--accent);
		color: #fff;
		transition: background 0.2s;
	}
	.card-btn:hover {
		background: var(--accent-hover);
	}
	.empty-message {
		grid-column: 1 / -1;
		text-align: center;
		padding: 60px 20px;
		color: var(--text-muted);
		font-size: 1.1rem;
	}
	.empty-message[hidden] {
		display: none;
	}

	@media (max-width: 600px) {
		.portal-header {
			padding: 16px 16px 24px;
		}
		.portal-title {
			font-size: 1.6rem;
		}
		.toolbar,
		.cards-container {
			padding: 0 16px;
		}
	}
</style>
